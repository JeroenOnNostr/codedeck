{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "deep-link:default",
    "notification:default",
    "background-relay:default",
    "mesh:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }]
    }
  ]
}
